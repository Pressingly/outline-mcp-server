# Outline MCP Server — example configuration. Copy to .env and fill in.
# NEVER commit a real .env file.

# --- stdio mode ---
OUTLINE_API_KEY=ol_api_your_key_here
OUTLINE_API_URL=https://app.getoutline.com/api

# --- optional behaviour ---
# OUTLINE_READ_ONLY=false
# OUTLINE_DISABLE_AI_TOOLS=false
# OUTLINE_VERIFY_SSL=true

# --- http mode ---
# MCP_HTTP_PORT=8213
# MCP_ALLOWED_ORIGINS=*
# MCP_LOG_LEVEL=INFO
