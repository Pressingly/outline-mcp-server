# Outline MCP Server — example configuration. Copy to .env and fill in.
# NEVER commit a real .env file.

# --- stdio mode ---
OUTLINE_API_KEY=ol_api_your_key_here
OUTLINE_API_URL=https://app.getoutline.com/api

# --- optional behaviour ---
# OUTLINE_READ_ONLY=false
# OUTLINE_DISABLE_AI_TOOLS=false
# Delete tools are OFF by default — set to true to opt in to
# delete_document / delete_collection / batch_delete_documents.
# OUTLINE_ENABLE_DELETE=false
# Bulk write tools are OFF by default — set to true to opt in to
# batch_archive_documents / batch_move_documents / batch_update_documents /
# batch_create_documents. batch_delete_documents stays under
# OUTLINE_ENABLE_DELETE.
# OUTLINE_ENABLE_BATCH_OPS=false
# OUTLINE_VERIFY_SSL=true

# --- http mode ---
# MCP_HTTP_PORT=8213
# MCP_ALLOWED_ORIGINS=*
# MCP_LOG_LEVEL=INFO
